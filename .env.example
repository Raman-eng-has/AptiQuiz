# Database
DATABASE_URL="postgresql://aptiquiz:aptiquiz_dev_password@localhost:5432/aptiquiz?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# Backend Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS and QR codes)
FRONTEND_URL="http://localhost:3000"

# Frontend Environment Variables (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# OAuth (optional - add your credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Email (optional - for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@aptiquiz.com"

# File Upload (optional - for images)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760