{
  "name": "AptiQuiz Fair Play",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Fair Play enforcement extension for AptiQuiz quizzes. Reports tab switches, detects other windows, blocks clipboard reads, sends heartbeat.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.aptiquiz.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://*.aptiquiz.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["http://localhost:3000/*", "https://*.aptiquiz.com/*"]
    }
  ]
}