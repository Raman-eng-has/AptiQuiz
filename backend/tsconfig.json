{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@aptiquiz/shared": ["../shared/src"]
    }
  },
  "include": ["src/index.ts", "src/middleware/**/*", "src/routes/*.ts", "src/socket/**/*"],
  "exclude": ["node_modules", "dist", "prisma", "tests", "src/routes.bak", "src/routes.disabled"]
}